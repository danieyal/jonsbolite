# Normalise line endings in the repo, check out native.
* text=auto

# PowerShell is checked out CRLF so scripts stay well-behaved under Windows PowerShell 5.1.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts, systemd units and udev rules must stay LF even when checked out on
# Windows — a CRLF shebang line makes the kernel refuse to run the script.
*.sh text eol=lf
*.service text eol=lf
*.rules text eol=lf

# Never touch these.
*.png binary
*.ico binary
*.exe binary
*.dll binary
*.asar binary
*.pak binary
*.bin binary
*.ttf binary
