<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net8.0 is the Linux/portable build; net8.0-windows adds WinForms for the tray
         and LibreHardwareMonitor for sensors. Building both is what proves the Linux
         code still compiles from a Windows dev box. -->
    <TargetFrameworks>net8.0;net8.0-windows</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>JonsboLite</AssemblyName>
    <RootNamespace>JonsboLite</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>1.0.0</Version>
    <!-- Single file needs a RID; publishing without one still produces a portable build. -->
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- Platform implementations are selected by folder, so neither can accidentally leak
       into the other's build. Platform.cs picks between them with #if WINDOWS. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0-windows'">
    <Compile Remove="Windows\**" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <Compile Remove="Linux\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.7-pre715" />
  </ItemGroup>

  <!-- Protocol, config and the platform abstractions. Plain net8.0, no OS dependency. -->
  <ItemGroup>
    <ProjectReference Include="..\JonsboLite.Core\JonsboLite.Core.csproj" />
  </ItemGroup>

  <!-- LibreHardwareMonitorLib pulls in Mono.Posix.NETStandard for its Linux paths, which
       drags ~1.5 MB of native helpers we can never execute on a Windows-only build.
       Verified: the app runs identically without them. -->
  <Target Name="DropMonoPosixNatives" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(Filename)').Contains('MonoPosixHelper'))" />
    </ItemGroup>
  </Target>

</Project>
